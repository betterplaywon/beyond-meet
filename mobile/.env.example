# ============================================
# Beyond Meet Mobile App - Environment Variables Template
# ============================================
#
# 이 파일은 템플릿입니다. 실제 사용을 위해서는 아래 파일을 생성하세요:
#
# 1. 개발 환경: .env.development
#    cp mobile/.env.example mobile/.env.development
#
# 2. 프로덕션 환경: .env.production
#    cp mobile/.env.example mobile/.env.production
#
# 3. 기본 .env (선택사항, 개발 환경과 동일하게 설정)
#    cp mobile/.env.development mobile/.env

# ============================================
# API Configuration
# ============================================
# Development: http://localhost:3000
# Production: https://beyond-meet-api.onrender.com (또는 실제 배포 URL)
API_BASE_URL=

# ============================================
# Agora WebRTC Configuration
# ============================================
# Agora Console에서 발급받은 App ID를 입력하세요
# https://console.agora.io
#
# 주의:
# - 개발/프로덕션 환경에 따라 다른 App ID를 사용할 수 있습니다.
# - AGORA_APP_ID는 공개 정보이므로 Git에 커밋해도 보안상 문제 없지만,
#   프로젝트 관리 차원에서 .env 파일로 분리하는 것을 권장합니다.
AGORA_APP_ID=your-agora-app-id-here
