# ============================================
# Beyond Meet Mobile App - Environment Variables
# ============================================

# API Configuration
# Development: http://localhost:3000 (로컬 테스트용)
# Production: (배포된 API)
API_BASE_URL=

# Agora WebRTC Configuration
# Agora Console에서 발급받은 App ID를 입력하세요
# https://console.agora.io
AGORA_APP_ID=your-agora-app-id-here
