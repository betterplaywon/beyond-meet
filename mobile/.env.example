# Beyond Meet - Mobile App Environment Variables
# 이 파일을 복사해서 .env 파일을 만들어주세요: cp .env.example .env

# API Base URLs (Development)
# iOS: localhost 사용
# Android: 10.0.2.2 (에뮬레이터) 또는 Mac의 실제 IP 주소
API_BASE_URL_IOS=
API_BASE_URL_ANDROID=

# API Base URL (Production)
API_BASE_URL=

# Agora WebRTC App ID
# ⚠️ 프로덕션 배포 시 실제 App ID 설정 필요
# Agora Console: https://console.agora.io/
AGORA_APP_ID=your-agora-app-id-here
