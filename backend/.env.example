# Server
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000

# Database (Supabase or Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database

# Redis (Upstash)
UPSTASH_REDIS_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_TOKEN=your-token

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# Agora
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# Firebase
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Beta Test Settings
BETA_USER_LIMIT=30

# Hugging Face API (for AI Content Moderation)
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxx

# Content Moderation Settings
MODERATION_THRESHOLD_MINOR=0.3   # Warning threshold (blur + warning)
MODERATION_THRESHOLD_SEVERE=0.6  # Force termination threshold (end call + auto-report)
MODERATION_ENABLED=true          # Enable/disable moderation feature
